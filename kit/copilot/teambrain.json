{
  "version": 1,
  "hooks": {
    "sessionStart": [
      {
        "name": "teambrain-sync",
        "bash": "[ -d \"$HOME/.teambrain/repo/.git\" ] && (git -C \"$HOME/.teambrain/repo\" pull --rebase --quiet origin main >/dev/null 2>&1 &) || true",
        "powershell": "if (Test-Path \"$env:USERPROFILE\\.teambrain\\repo\\.git\") { Start-Process -NoNewWindow git -ArgumentList '-C',\"$env:USERPROFILE/.teambrain/repo\",'pull','--rebase','--quiet' }"
      }
    ],
    "sessionEnd": [
      {
        "name": "teambrain-digest",
        "bash": "D=\"$HOME/.teambrain/repo/kit/bin/teambrain-digest.sh\"; [ -f \"$D\" ] || D=\"$HOME/.teambrain/bin/teambrain-digest.sh\"; [ -f \"$D\" ] && bash \"$D\" || true",
        "powershell": "$d = \"$env:USERPROFILE/.teambrain/repo/kit/bin/teambrain-digest.sh\"; if (-not (Test-Path $d)) { $d = \"$env:USERPROFILE/.teambrain/bin/teambrain-digest.sh\" }; if (Test-Path $d) { bash $d }"
      }
    ]
  }
}
