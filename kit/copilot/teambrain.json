{
  "version": 1,
  "hooks": {
    "sessionStart": [
      {
        "name": "teambrain-sync",
        "bash": "[ -d \"$HOME/.teambrain/repo/.git\" ] && (git -C \"$HOME/.teambrain/repo\" pull --rebase --quiet origin main >/dev/null 2>&1 &) || true",
        "powershell": "if (Test-Path \"$env:USERPROFILE\\.teambrain\\repo\\.git\") { Start-Process -NoNewWindow git -ArgumentList '-C',\"$env:USERPROFILE/.teambrain/repo\",'pull','--rebase','--quiet' }"
      }
    ],
    "sessionEnd": [
      {
        "name": "teambrain-digest",
        "bash": "[ -x \"$HOME/.teambrain/bin/teambrain-digest.sh\" ] && \"$HOME/.teambrain/bin/teambrain-digest.sh\" || true",
        "powershell": "if (Test-Path \"$env:USERPROFILE\\.teambrain\\bin\\teambrain-digest.sh\") { bash \"$env:USERPROFILE/.teambrain/bin/teambrain-digest.sh\" }"
      }
    ]
  }
}
